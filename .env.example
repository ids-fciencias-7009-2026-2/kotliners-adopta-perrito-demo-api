# Base de datos PostgreSQL
URL_DB=localhost:5432/colitas_db
USER_DB=tu_usuario_postgres
PASSWORD_DB=tu_password_postgres

# Correo Gmail SMTP
# Genera una App Password en: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=tu_correo@gmail.com
GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx
MAIL_FROM=tu_correo@gmail.com

# Cloudinary — https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# APIs externas de razas (opcionales)
# The Dog API — https://thedogapi.com (gratis, requiere registro)
DOG_API_KEY=tu_key_de_thedogapi
# The Cat API — https://thecatapi.com (gratis, requiere registro)
CAT_API_KEY=tu_key_de_thecatapi
